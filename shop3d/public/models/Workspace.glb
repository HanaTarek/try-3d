rgba(255, 255, 255, 0) 95deg, rgba(255, 255, 255, 0) 360deg); width: 200%; =
animation: 7s linear 0s infinite normal none running cta-border-orbit; posi=
tion: absolute; top: 50%; left: 50%; translate: -50% -50%; }

@keyframes cta-border-orbit {=20
  100% { rotate: 360deg; }
}

