.cta-flow-surface::before { content: ""; background: linear-gradient(155.05=
6deg, rgb(170, 255, 202) 0%, rgb(186, 255, 74) 50%, rgb(170, 255, 202) 100%=
); width: 200%; height: 200%; animation: 5s ease-in-out 0s infinite normal =
none running cta-flow-sweep; position: absolute; top: 0px; left: 0px; }

