rmal both running k8DJEG_guideHeroCardIn; }

.oeoyqa_strip { --s: calc(120 / 144); }

@media (min-width: 480px) {
  .oeoyqa_strip { --s: calc(132 / 144); }
}

@media (min-width: 1120px) {
  .oeoyqa_strip { --s: 1; }
}

.oeoyqa_base { height: calc(144px * var(--s)); object-fit: cover; object-po=
sition: left top; pointer-events: none; user-select: none; z-index: -3; wid=
th: auto; min-width: 100%; max-width: none; position: absolute; top: 0px; l=
eft: 0px; }

.oeoyqa_lightsLeft { left: calc(331px * var(--s)); top: calc(-10.33px * var=
(--s)); width: calc(189.565px * var(--s)); height: calc(63.334px * var(--s)=
); object-fit: cover; pointer-events: none; user-select: none; z-index: -1;=
 position: absolute; }

.oeoyqa_gap { align-self: stretch; min-width: 0px; position: relative; }

.oeoyqa_door { top: 0px; left: calc(50% - 168px * var(--s)); width: calc(51=
2px * var(--s)); height: calc(144px * var(--s)); pointer-events: none; user=
-select: none; z-index: -2; position: absolute; }

.oeoyqa_door > * { position: absolute; }

.oeoyqa_keyVisual { width: 100%; height: 100%; inset: 0px; }

.oeoyqa_bats { left: calc(-69px * var(--s)); top: calc(52px * var(--s)); wi=
dth: calc(123.577px * var(--s)); height: auto; }

.oeoyqa_right { width: calc(505px * var(--s)); height: calc(144px * var(--s=
)); pointer-events: none; user-select: none; z-index: -1; position: absolut=
e; top: 0px; right: 0px; }

.oeoyqa_right > * { width: 100%; height: 100%; position: absolute; inset: 0=
px; }

@media (max-width: 767px) {
  .oeoyqa_strands { display: none; }
}

@media (max-width: 1319px) {
  .oeoyqa_lightsLeft, .oeoyqa_hang { display: none; }
}
