@keyframes design4-agent-flip {=20
  0% { transform: rotateX(0deg); }
  50% { transform: rotateX(180deg); }
  100% { transform: rotateX(360deg); }
}

@keyframes design4-flip-out {=20
  0% { transform: rotateX(0deg); }
  100% { transform: rotateX(90deg); }
}

@keyframes design4-flip-in {=20
  0% { transform: rotateX(-90deg); }
  100% { transform: rotateX(0deg); }
}

@keyframes design4-peripheral-in {=20
  0% { opacity: 0; transform: scale(0.95); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes design4-border-spin {=20
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}

@keyframes design4-glow-drift-green {=20
  0% { transform: translate(-3%) rotate(0deg); }
  50% { transform: translate(3%, -2%) rotate(4deg); }
  100% { transform: translate(-3%) rotate(0deg); }
}

@keyframes design4-glow-drift-blue {=20
  0% { transform: translateY(2%) rotate(0deg); }
  50% { transform: translate(-2%, -2%) rotate(-3deg); }
  100% { transform: translateY(2%) rotate(0deg); }
}

@keyframes design4-glow-drift-pink {=20
  0% { transform: translate(2%, -2%) rotate(0deg); }
  50% { transform: translate(-2%, 2%) rotate(5deg); }
  100% { transform: translate(2%, -2%) rotate(0deg); }
}

@keyframes design4-upload-flow-x {=20
  0% { background-position: 0% center; }
  100% { background-position: 200% center; }
}

