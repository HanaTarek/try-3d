------MultipartBoundary--0ovr7neG0uSEyvCGP4iAPgYocPaap5DzIL65o6i12D----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: https://cdn.meshy.ai/webapp-build-assets/production/_next/static/chunks/1k8s9jevq20ni.css

@charset "utf-8";

.FUippq_video { mask: linear-gradient(rgba(0, 0, 0, 0) 0px, rgb(0, 0, 0) 42=
px, rgb(0, 0, 0) 292px, rgba(0, 0, 0, 0) 330px) 0px 0px intersect, linear-g=
radient(90deg, rgba(0, 0, 0, 0) 0px, rgb(0, 0, 0) 36px, rgb(0, 0, 0) 294px,=
 rgba(0, 0, 0, 0) 330px) 0px 0px; }

.FUippq_title { background: linear-gradient(rgb(255, 242, 198) 0%, rgb(255,=
 213, 106) 45%, rgb(255, 171, 46) 100%) text; color: rgba(0, 0, 0, 0); filt=
er: drop-shadow(rgba(90, 30, 0, 0.35) 0px 2px) drop-shadow(rgba(255, 170, 5=
0, 0.35) 0px 0px 14px); }

.FUippq_card { box-shadow: rgba(176, 132, 255, 0.55) 0px 0px 0px 1.5px, rgb=
a(124, 77, 255, 0.15) 0px 0px 0px 7px, rgba(124, 77, 255, 0.35) 0px 0px 60p=
x, rgba(0, 0, 0, 0.55) 0px 40px 90px, rgba(255, 255, 255, 0.14) 0px 1px ins=
et; }

.FUippq_claim { background-image: linear-gradient(rgb(210, 255, 111), rgb(1=
79, 255, 29)); transition: background-image 0.5s cubic-bezier(0.22, 1, 0.36=
, 1), box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1), filter 0.5s cubic-bez=
ier(0.22, 1, 0.36, 1); }

.FUippq_claimHover:hover { filter: brightness(1.2); background-image: linea=
r-gradient(rgb(196, 255, 106), rgb(154, 255, 46)); box-shadow: rgba(165, 25=
5, 70, 0.4) 0px 0px 8px; }

.FUippq_bulb { animation: 1.6s ease-in-out 0s infinite normal none running =
FUippq_twinkle; }

@keyframes FUippq_twinkle {=20
  50% { opacity: 0.45; }
}

.FUippq_enter .FUippq_card { animation: 0.52s cubic-bezier(0.2, 0.9, 0.3, 1=
) 60ms 1 normal both running FUippq_card-in; }

.FUippq_enter .FUippq_lights { animation: 0.6s ease-out 0.3s 1 normal both =
running FUippq_lights-in; }

.FUippq_enter .FUippq_rise { animation: 0.42s ease-out 0s 1 normal both run=
ning FUippq_rise-in; }

@keyframes FUippq_card-in {=20
  0% { opacity: 0; transform: scale(0.86) translateY(30px); }
  70% { opacity: 1; transform: scale(1.02); }
  100% { opacity: 1; transform: none; }
}

@keyframes FUippq_lights-in {=20
  0% { opacity: 0; transform: translateY(-30px); }
  70% { opacity: 1; transform: translateY(4px); }
  100% { opacity: 1; transform: none; }
}

@keyframes FUippq_rise-in {=20
  0% { opacity: 0; transform: translateY(12px); }
  100% { opacity: 1; transform: none; }
}

.FUippq_leaving { opacity: 0; transition: opacity 0.7s ease-in-out, transfo=
rm 0.7s ease-in; transform: scale(0.97) translateY(6px); }

.FUippq_spin { animation: 0.75s linear 0s infinite normal none running FUip=
pq_spin; }

@keyframes FUippq_spin {=20
  100% { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .FUippq_bulb, .FUippq_spin, .FUippq_enter .FUippq_card, .FUippq_enter .FU=
ippq_lights, .FUippq_enter .FUippq_rise { animation: auto ease 0s 1 normal =
none running none; }
}
