gba(37, 37, 37, 0.8); border: 1px solid rgba(255, 255, 255, 0.08); }
  .bg-bg-glass, .surface-glass { background-color: var(--color-bg-glass); b=
ackdrop-filter: blur(var(--blur-glass)); }
  .surface-veil { background-color: var(--color-bg-modal-overlay); backdrop=
-filter: blur(var(--blur-modal-overlay)); }
