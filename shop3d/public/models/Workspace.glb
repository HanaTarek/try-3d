.react-joyride__custom-tooltip { animation: 0.5s ease-in-out 0s 1 normal fo=
rwards running fade-in; }

.react-joyride__custom-tooltip.playground-key-reminder-tooltip { text-align=
: left; background-color: var(--color-bg-glass); width: fit-content; max-wi=
dth: 300px; min-height: 38px; backdrop-filter: blur(var(--blur-glass)); bor=
der: 1px solid rgba(255, 255, 255, 0.08); border-radius: 0.75rem; gap: 6px;=
 padding: 10px 12px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.15) 0px =
5px 18px; }

.react-joyride__custom-tooltip.playground-key-reminder-tooltip > svg { disp=
lay: none; }

.react-joyride__floater:has(.playground-key-reminder-tooltip) { filter: non=
e !important; }

.react-joyride__custom-tooltip.nav-sidebar-intro-tooltip { background-color=
: var(--color-bg-glass); width: 280px; backdrop-filter: blur(var(--blur-gla=
ss)); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 0.75rem; =
gap: 12px; padding: 12px; box-shadow: rgba(0, 0, 0, 0.15) 0px 5px 18px; }

.react-joyride__custom-tooltip.nav-sidebar-intro-tooltip > svg { display: n=
one; }

.react-joyride__custom-tooltip.nav-sidebar-intro-tooltip::after { content: =
""; top: var(--nav-intro-arrow-y,50%); background-color: var(--color-bg-gla=
ss); width: 12px; height: 12px; backdrop-filter: blur(var(--blur-glass)); c=
lip-path: polygon(0px 0px, 0px 100%, 100% 100%); border-bottom: 1px solid r=
gba(255, 255, 255, 0.08); border-left: 1px solid rgba(255, 255, 255, 0.08);=
 border-bottom-left-radius: 3px; position: absolute; left: -6px; transform:=
 translateY(-50%) rotate(45deg); }

