  0% { transform: scaleX(0); }
  100% { transform: scaleX(1); }
}

.jVQzHq_progress { transform-origin: 0px center; animation: jVQzHq_heroSlid=
eProgress var(--hero-slide-duration) linear forwards; }

.jVQzHq_progressStatic { transform: scaleX(1); }

.jVQzHq_progressPaused { animation-play-state: paused; }

@media (prefers-reduced-motion: reduce) {
  .jVQzHq_progress { animation: auto ease 0s 1 normal none running none; tr=
ansform: scaleX(1); }
}

