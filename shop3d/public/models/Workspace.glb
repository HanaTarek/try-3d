x) 0px 0px; }

.discover-cta-flow-ring { pointer-events: none; border-radius: inherit; bac=
kground: conic-gradient(from var(--cta-border-angle),#fff0 0deg,#fffffff2 4=
5deg,#fff0 95deg,#fff0 360deg); padding: 2px; animation: 7s linear 0s infin=
ite normal none running cta-border-spin; position: absolute; inset: 0px; ma=
sk: linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 0px) 0px 0px content-box=
