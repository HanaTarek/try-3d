erit; padding: var(--flow-ring-stroke); background: conic-gradient(from var=
(--cta-border-angle),var(--flow-ring-base)0deg,var(--flow-ring-highlight)45=
deg,var(--flow-ring-base)95deg,var(--flow-ring-base)360deg); animation: 12s=
