  .cw0CyG_stats { grid-template-columns: 1fr; }
}

@media (prefers-reduced-motion: reduce) {
  .cw0CyG_page { scroll-behavior: auto; }
  .cw0CyG_art::before, .cw0CyG_art::after, .cw0CyG_cdValue, .cw0CyG_offerBi=
g, .cw0CyG_promptTryThumb, .cw0CyG_ribbon, .cw0CyG_star { animation: auto e=
ase 0s 1 normal none running none; }
  .cw0CyG_giftLid, .cw0CyG_giftSpark { transition: none; }
  .cw0CyG_offerCta:hover .cw0CyG_confetti i, .cw0CyG_showcaseReel { animati=
on: auto ease 0s 1 normal none running none; }
  .cw0CyG_showcaseGroup[aria-hidden] { display: none; }
  .cw0CyG_showcaseTrack { overflow-x: auto; }
}

@media (hover: none) {
  .cw0CyG_showcaseTrack .cw0CyG_tile { --tile-size: 200px; }
  .cw0CyG_tileDownload { opacity: 1; max-width: calc(100% - 16px); transfor=
m: translate(-50%); }
}

