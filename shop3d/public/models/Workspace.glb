:root { --sidebar-collapsed-w: 68px; --header-h: 3rem; }

@media (min-width: 30rem) {
  :root { --header-h: 3.5rem; }
}

[data-nav-variant=3D"sidebar"] { --header-h: 0px; }

[data-news-ticker-shown] ~ main { --news-ticker-h: 3rem; }

:has(> [data-sidebar-nav-inset]) { padding-left: var(--sidebar-collapsed-w)=
; --sidebar-w: var(--sidebar-collapsed-w); --header-h: 0px; }

[data-sidebar-nav-inset] ~ .w-screen:not(.fixed), [data-sidebar-nav-inset] =
~ * .w-screen:not(.fixed) { width: calc(100vw - var(--sidebar-w)); }

[data-radix-popper-content-wrapper]:has(.sidebar-submenu-panel) { backdrop-=
filter: blur(30px); background-color: rgba(37, 37, 37, 0.8); border: 1px so=
lid rgba(255, 255, 255, 0.08); border-radius: 1rem; overflow: hidden; }

[data-radix-popper-content-wrapper]:has(.sidebar-submenu-panel) .sidebar-su=
bmenu-panel { box-shadow: none !important; background: 0px 0px !important; =
border-width: medium !important; border-style: none !important; border-colo=
r: currentcolor !important; border-image: none !important; }

[data-radix-popper-content-wrapper]:has(.sidebar-submenu-panel-nested) { ov=
erflow: visible; }

[data-radix-popper-content-wrapper]:has(.sidebar-submenu-panel-nested)::bef=
ore { content: ""; width: 4px; position: absolute; inset-block: 0px; }

[data-radix-popper-content-wrapper]:has(.sidebar-submenu-panel-nested[data-=
side=3D"right"])::before { right: 100%; }

[data-radix-popper-content-wrapper]:has(.sidebar-submenu-panel-nested[data-=
side=3D"left"])::before { left: 100%; }

@keyframes glowSpin {=20
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}

@keyframes orbitGlowPulse {=20
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.14); }
}

@keyframes blink {=20
  0%, 45% { opacity: 1; }
  50%, 95% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes arrow-nudge {=20
  0%, 100% { transform: translate(-2px); }
  50% { transform: translate(2px); }
}

@keyframes orbitHintHeartbeat {=20
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.22); }
}

@keyframes shimmer-sweep {=20
  0% { background-position: 100% 0px; }
  100% { background-position: -100% 0px; }
}

@keyframes upgrade-gradient-flow {=20
  0% { background-position: 0% center; }
  50% { background-position: 100% center; }
  100% { background-position: 0% center; }
}

.upgrade-gold-border { position: relative; }

.upgrade-gold-border::before { content: ""; border-radius: inherit; pointer=
-events: none; background: linear-gradient(101.16deg, rgb(249, 232, 85) 12.=
91%, rgb(233, 148, 48) 90.11%); padding: 1px; position: absolute; inset: 0p=
x; mask: linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 0px) 0px 0px conten=
t-box exclude, linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 0px) 0px 0px;=
 }

@keyframes shimmer-block-sweep {=20
  0% { transform: translate(-100%, -100%); }
  100% { transform: translate(100%, 100%); }
}

@property --removed-body-scroll-bar-size { syntax: "<length>"; inherits: fa=
lse; initial-value: 0; }

html { --meshy-css-ready: 1; }

.tl-watermark_SEE-LICENSE { display: none !important; }

